# Variáveis de ambiente do site. Copie para `.env.local` (desenvolvimento) e preencha.
# Em produção, cadastre as mesmas variáveis no painel da Netlify. NUNCA coloque valores reais neste arquivo.
# Sem as duas variáveis públicas do Supabase, a Área do Aluno continua em modo de demonstração.

# Endereço público do site (opcional). Usado em links absolutos, como o do e-mail de recuperação de senha.
# Em desenvolvimento local use http://localhost:3000; sem isso, os links apontam para https://saletebrocca.com.
NEXT_PUBLIC_SITE_URL=

# Supabase: URL do projeto (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase: chave publicável (sb_publishable_...). Pública por desenho; a segurança vem do RLS do banco.
# Projetos antigos podem colocar aqui a chave "anon" no lugar.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase: chave de serviço (secreta). Só o servidor usa (webhook da Kiwify). Ignora o RLS.
# Nunca use o prefixo NEXT_PUBLIC e nunca envie ao navegador nem ao Git.
SUPABASE_SERVICE_ROLE_KEY=

# Kiwify: token do webhook (secreto). Confere que o aviso de compra vem mesmo da Kiwify.
KIWIFY_WEBHOOK_TOKEN=

# Kiwify: token anterior (opcional, secreto). Só durante a troca do token: o webhook aceita os dois por um tempo.
KIWIFY_WEBHOOK_TOKEN_PREVIOUS=

# Hotmart: token HOTTOK do webhook (secreto, opcional até ativar a integração Hotmart no painel Financeiro).
HOTMART_WEBHOOK_TOKEN=

# Mux: chave de assinatura dos vídeos das aulas (Settings > Signing Keys, no ambiente do curso). Secretas.
# Só assinam tokens de reprodução; sem elas o vídeo da aula responde "indisponível". Veja docs/10-GUIA-MUX.md.
MUX_SIGNING_KEY_ID=
# Private Key exatamente como a Mux entrega (base64, uma linha).
MUX_SIGNING_PRIVATE_KEY=

# Mux API (opcional, somente leitura): monitoramento de uso, minutos e banda na aba Stream do painel (/admin/stream).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# Backup completo AES-256-GCM (/admin/backup): chave secreta exclusiva desta instância (32+ caracteres).
BACKUP_ENCRYPTION_KEY=
# Backup no GitHub: token com permissão contents:write em um repositório PRIVADO dedicado (nunca o repo público).
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=

# Marketing / Analytics (/admin/marketing): Meta Pixel (público) e Conversions API (secreto).
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# ADM E-mails (/admin/emails): envio via Resend e token opcional do webhook de entrada.
RESEND_API_KEY=
ADMIN_FROM_EMAIL=contato@saletebrocca.com
ADMIN_EMAIL_INBOUND_TOKEN=
